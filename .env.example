# For apps/api (api.metro.box). A daemon run with `metro serve` needs none of this.

# Required
DATABASE_URL=postgres://user:pass@host:5432/metro
METRO_AUTH_SIGNING_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
GOOGLE_OAUTH_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=...
MICROSOFT_OAUTH_CLIENT_ID=...
MICROSOFT_OAUTH_CLIENT_SECRET=...
OPERATOR_USER_ID=user_...

# Optional
# METRO_LOG_LEVEL=info
