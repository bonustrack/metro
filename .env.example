# Station secrets (bot tokens, mnemonics, sessions) live in the accounts table, not here.

# Required
DATABASE_URL=postgres://user:pass@host:5432/metro

# Google sign-in for the web UI. Redirect URI: <base-url>/auth/google/callback
# GOOGLE_OAUTH_CLIENT_ID=xxxxx.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=xxxxx
# METRO_SESSION_SECRET=long-random-string

# Optional
# METRO_AGENT=1                                     # serve only this agent
# METRO_LOG_LEVEL=info
# METRO_PUBLIC_URL=https://mcp.metro.box            # base URL for attachment links
