DATABASE_URL=postgres://user:pass@host:5432/metro
# METRO_AGENT=1
# METRO_MCP_HTTP_TOKEN=
# METRO_LOG_LEVEL=info
# Google sign-in for the web UI (server-side OAuth authorization-code flow).
# One Google "Web" OAuth client; redirect URI https://mcp.metro.box/auth/google/callback.
# GOOGLE_OAUTH_CLIENT_ID=xxxxx.apps.googleusercontent.com
# GOOGLE_OAUTH_CLIENT_SECRET=xxxxx
# Map verified Google emails to the agent name(s) their session may view/operate.
# GOOGLE_EMAIL_AGENTS={"fabien@bonustrack.co":["tony"]}
# Secret used to sign the OAuth state and the daemon session JWT (HS256). Keep long/random.
# METRO_SESSION_SECRET=change-me-to-a-long-random-string
# Optional overrides: GOOGLE_OAUTH_REDIRECT_URI, METRO_SESSION_TTL_SEC (default 30d).
