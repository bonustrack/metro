{
  "name": "@stage-labs/metro",
  "version": "0.1.0-beta.46",
  "description": "The metro command line. Sign in once per machine, then hand your MCP connector list to Claude Code without the credentials touching disk, argv or shell history.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bonustrack/metro.git"
  },
  "homepage": "https://github.com/bonustrack/metro#readme",
  "bugs": "https://github.com/bonustrack/metro/issues",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "metro": "dist/cli.js"
  },
  "files": [
    "dist",
    "runtime"
  ],
  "publishConfig": {
    "access": "public",
    "tag": "beta"
  },
  "scripts": {
    "build": "tsc && node scripts/stage-runtime.mjs",
    "prepublishOnly": "tsc && node scripts/stage-runtime.mjs",
    "test": "tsc --noEmit && node scripts/stage-runtime.mjs && bun test test/"
  },
  "devDependencies": {
    "@stage-labs/config": "0.1.0-beta.2",
    "eslint": "^10.3.0",
    "knip": "^6.15.0",
    "madge": "^8.0.0",
    "typescript": "^5"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@mtcute/bun": "0.30.1",
    "@xmtp/content-type-primitives": "^3.0.1",
    "@xmtp/content-type-reaction": "^2.0.2",
    "@xmtp/content-type-remote-attachment": "^2.0.4",
    "@xmtp/content-type-reply": "^2.0.3",
    "@xmtp/content-type-wallet-send-calls": "^2.0.0",
    "@xmtp/node-bindings": "1.9.1",
    "@xmtp/node-sdk": "^6.0.0",
    "baileys": "7.0.0-rc14",
    "discord.js": "^14.26.4",
    "drizzle-orm": "^0.44.0",
    "pino": "^9.5.0",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.5",
    "prism-media": "^1.3.5",
    "viem": "^2.52.2",
    "zod": "^3.23.8"
  }
}
