{
  "name": "@metro-labs/core",
  "version": "0.1.0",
  "private": true,
  "description": "What every metro process shares: the logger, the event bus and its types, ids, secure file writes, the train protocol, station types and attachment handling. No HTTP, no policy.",
  "type": "module",
  "exports": {
    "./log": "./src/log.ts",
    "./events": "./src/events.ts",
    "./identity": "./src/identity.ts",
    "./is-record": "./src/is-record.ts",
    "./secure-fs": "./src/secure-fs.ts",
    "./version": "./src/version.ts",
    "./train-error": "./src/train-error.ts",
    "./trains/protocol": "./src/protocol.ts",
    "./ids": "./src/ids.ts",
    "./address": "./src/address.ts",
    "./station-names": "./src/station-names.ts",
    "./str": "./src/str.ts",
    "./lines": "./src/lines.ts",
    "./endpoints": "./src/endpoints.ts",
    "./stations/types": "./src/stations/types.ts",
    "./stations/station-runtime": "./src/stations/station-runtime.ts",
    "./stations/account-store": "./src/stations/account-store.ts",
    "./stations/attachments": "./src/stations/attachments.ts",
    "./stations/messaging-normalize": "./src/stations/messaging-normalize.ts"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsc --noEmit && METRO_STATE_DIR=\"$(mktemp -d /tmp/metro-test.XXXXXX)\" bun test test/"
  },
  "dependencies": {
    "pino": "^9.5.0",
    "pino-pretty": "^13.1.3"
  },
  "devDependencies": {
    "@stage-labs/config": "0.1.0-beta.2",
    "eslint": "^10.3.0",
    "knip": "^6.15.0",
    "madge": "^8.0.0",
    "typescript": "^5"
  }
}
