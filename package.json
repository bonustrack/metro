{
  "name": "metro-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "packageManager": "bun@1.4.0",
  "scripts": {
    "lint": "stage lint",
    "typecheck": "stage typecheck",
    "test": "turbo test",
    "knip": "stage knip",
    "madge": "stage madge",
    "build": "turbo build",
    "start": "bun apps/daemon/src/server.ts",
    "smoke": "bash scripts/smoke.sh",
    "compat": "bash scripts/compat.sh",
    "sdk-runner-check": "bun scripts/sdk-runner/run.ts",
    "sdk-runner-long": "bun scripts/sdk-runner/long.ts",
    "sdk-runner-model": "bun scripts/sdk-runner/model.ts",
    "sdk-runner-activity": "bun scripts/sdk-runner/activity.ts",
    "metro-user-check": "bash scripts/metro-user/run.sh",
    "secret-modes": "bash scripts/secret-modes.sh",
    "secret-boundary-check": "bash scripts/secret-boundary-check.sh"
  },
  "devDependencies": {
    "@stage-labs/config": "0.1.0-beta.3",
    "@types/bun": "^1.2.0",
    "@types/node": "^22.10.0",
    "eslint": "^10.3.0",
    "knip": "^6.15.0",
    "madge": "^8.0.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "turbo": "^2.5.0",
    "typescript": "^5"
  },
  "patchedDependencies": {
    "expo-router@57.0.23": "patches/expo-router@57.0.23.patch",
    "expo-dev-launcher@57.0.20": "patches/expo-dev-launcher@57.0.20.patch"
  }
}
